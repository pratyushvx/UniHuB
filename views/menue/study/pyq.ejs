<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View PYQs - UniHub</title>
    <link rel="stylesheet" href="/css/partials.css">
    <link rel="stylesheet" href="/css/study/view.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body>
    <%- include('../../partials/navbar') %>
    
    <div class="container">
        <div class="page-header">
            <h2><i class="fas fa-book"></i> Previous Year Questions</h2>
            <a href="/study/upload-pyq" class="btn btn-primary">
                <i class="fas fa-plus"></i>
                Upload PYQ
            </a>
        </div>

        <div class="filters">
            <div class="filter-group">
                <label for="subjectFilter">Subject:</label>
                <select id="subjectFilter">
                    <option value="">All Subjects</option>
                    <option value="Mathematics">Mathematics</option>
                    <option value="Physics">Physics</option>
                    <option value="Chemistry">Chemistry</option>
                    <option value="Computer Science">Computer Science</option>
                    <option value="English">English</option>
                    <option value="Economics">Economics</option>
                    <option value="Biology">Biology</option>
                </select>
            </div>

            <div class="filter-group">
                <label for="semesterFilter">Semester:</label>
                <select id="semesterFilter">
                    <option value="">All Semesters</option>
                    <option value="1">Semester 1</option>
                    <option value="2">Semester 2</option>
                    <option value="3">Semester 3</option>
                    <option value="4">Semester 4</option>
                    <option value="5">Semester 5</option>
                    <option value="6">Semester 6</option>
                    <option value="7">Semester 7</option>
                    <option value="8">Semester 8</option>
                </select>
            </div>

            <div class="filter-group">
                <label for="yearFilter">Year:</label>
                <select id="yearFilter">
                    <option value="">All Years</option>
                    <option value="2024">2024</option>
                    <option value="2023">2023</option>
                    <option value="2022">2022</option>
                    <option value="2021">2021</option>
                    <option value="2020">2020</option>
                    <option value="2019">2019</option>
                </select>
            </div>

            <div class="search-box">
                <input type="text" id="searchInput" placeholder="Search PYQs...">
                <i class="fas fa-search"></i>
            </div>
        </div>

        <div class="notes-grid">
            <% if (pyqs && pyqs.length > 0) { %>
                <% pyqs.forEach(pyq => { %>
                    <div class="note-card" data-subject="<%= pyq.subject %>" data-semester="<%= pyq.semester %>" data-year="<%= pyq.year %>">
                        <div class="note-header">
                            <div class="note-icon">
                                <i class="fas fa-file-alt"></i>
                            </div>
                            <div class="note-meta">
                                <h3><%= pyq.title %></h3>
                                <span class="subject"><%= pyq.subject %></span>
                                <span class="semester">Semester <%= pyq.semester %> - <%= pyq.year %></span>
                            </div>
                        </div>
                        
                        <div class="note-content">
                            <p><%= pyq.description || 'No description available' %></p>
                        </div>
                        
                        <div class="note-footer">
                            <div class="note-info">
                                <span class="upload-date">
                                    <i class="fas fa-calendar"></i>
                                    <%= new Date(pyq.createdAt).toLocaleDateString() %>
                                </span>
                                <span class="uploader">
                                    <i class="fas fa-user"></i>
                                    <%= pyq.uploadedBy?.name || 'Anonymous' %>
                                </span>
                            </div>
                            
                            <div class="note-actions">
                                <% if (pyq.filePath) { %>
                                    <a href="/study/download-pyq/<%= pyq._id %>" class="btn btn-primary btn-sm">
                                        <i class="fas fa-download"></i> Download
                                    </a>
                                    <a href="/uploads/<%= pyq.filePath.split('/').pop() %>" target="_blank" class="btn btn-outline btn-sm">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                <% } %>
                                <button class="btn btn-outline btn-sm" onclick="sharePyq('<%= pyq._id %>')">
                                    <i class="fas fa-share"></i> Share
                                </button>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-book"></i>
                    <h3>No PYQs Found</h3>
                    <p>Be the first to upload a previous year question!</p>
                    <a href="/study/upload-pyq" class="btn btn-primary">
                        <i class="fas fa-upload"></i> Upload PYQ
                    </a>
                </div>
            <% } %>
        </div>
    </div>

    <script src="/js/pyqs.js"></script>
</body>
</html>
