<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>All Notes</title>
  <link rel="stylesheet" href="/css/notes.css">
</head>

<body>
  <!-- Navbar include -->
  <%- include ('../partials/navbar') %>

  <div class="container">
    <h1>📄 All Notes</h1>
    
    <% if (notes && notes.length > 0) { %>
      <div class="post-grid">
        <% notes.forEach(note => { %>
          <div class="post-card">
            <h3><%= note.title %></h3>
            <p><strong>Subject:</strong> <%= note.subject %></p>
            <p><strong>Semester:</strong> <%= note.semester %></p>
            <p><strong>Description:</strong> <%= note.description %></p>
            
            <div class="file-info">
              <strong>File Type:</strong> 
              <% if (note.fileType === 'image') { %>
                📷 Image
              <% } else { %>
                📄 PDF
              <% } %>
            </div>
            
            <a href="<%= note.fileUrl %>" target="_blank" class="btn">👁️ View</a>
            <a href="<%= note.fileUrl %>" download class="btn download">⬇️ Download</a>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="no-notes">
        <p>📝 No notes uploaded yet.</p>
        <p>Be the first to share your notes!</p>
      </div>
    <% } %>
  </div>
</body>
</html>
