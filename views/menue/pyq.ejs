<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>All PYQs</title>
  <link rel="stylesheet" href="/css/pyq.css">
</head>

<body>
  <%- include("../partials/navbar") %> 


  <div class="container">
    <h1>📚 All Previous Year Questions</h1>
    
    <% if (pyqs && pyqs.length > 0) { %>
      <div class="post-grid">
        <% pyqs.forEach(pyq => { %>
          <div class="post-card">
            <h3><%= pyq.title %></h3>
            <p><strong>Subject:</strong> <%= pyq.subject %></p>
            <p><strong>Semester:</strong> <%= pyq.semester %></p>
            <p><strong>Description:</strong> <%= pyq.description %></p>
            
            <div class="file-info">
              <strong>File Type:</strong> 
              <% if (pyq.fileType === 'image') { %>
                📷 Image
              <% } else { %>
                📄 PDF
              <% } %>
            </div>
            
            <a href="<%= pyq.fileUrl %>" target="_blank" class="btn">👁️ View</a>
            <a href="<%= pyq.fileUrl %>" download class="btn download">⬇️ Download</a>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="no-pyqs">
        <p>📚 No PYQs uploaded yet.</p>
        <p>Be the first to share previous year questions!</p>
      </div>
    <% } %>
  </div>
</body>
</html>
