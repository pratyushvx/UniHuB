<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Upload PYQ - uniHub</title>
  <link rel="stylesheet" href="/css/uploadPyq.css">
</head>
<body>
  <!-- Reuse your navbar -->
  <%- include("../partials/navbar") %>

  <div class="container">
    <h2>📤 Upload PYQ</h2>

    <form action="/unihub/upload-pyq" method="POST" enctype="multipart/form-data">
      <div class="form-group">
        <label for="title">Title</label>
        <input type="text" name="title" required placeholder="e.g. DBMS Midsem 2023">
      </div>

      <div class="form-group">
        <label for="subject">Subject</label>
        <input type="text" name="subject" required placeholder="e.g. Database Management">
      </div>

      <div class="form-group">
        <label for="semester">Semester</label>
        <select name="semester" required>
          <option value="">-- Select Semester --</option>
          <option value="1">1st</option>
          <option value="2">2nd</option>
          <option value="3">3rd</option>
          <option value="4">4th</option>
          <option value="5">5th</option>
          <option value="6">6th</option>
          <option value="7">7th</option>
          <option value="8">8th</option>
        </select>
      </div>

      <div class="form-group">
        <label for="description">Short Description</label>
        <textarea name="description" rows="4" placeholder="Mention exam type or year" required></textarea>
      </div>

      <div class="form-group">
        <label for="file">Upload PYQ File (PDF/Image)</label>
        <input type="file" name="file" accept=".pdf, .png, .jpg, .jpeg" required>
      </div>

      <button type="submit">Upload PYQ</button>
    </form>
  </div>
</body>
</html>
